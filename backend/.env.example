MFA_PHONE=+2519xxxxxxxx
SEED_PASSWORD=change-me-strong-password
PRODUCTION=true
CORS_ORIGINS=https://your-domain.example
REQUIRE_HTTPS=true
REQUIRE_MFA=true
JWT_EXPIRATION_MS=1800000
JWT_SECRET=generate-a-strong-random-secret
DB_PASSWORD=change-me
# Afro SMS (AfroMessage) gateway — server-side only. Never expose to the browser.
AFRO_SMS_ENABLED=true
AFRO_SMS_API_KEY=replace-with-your-afromessage-token
# Leave FROM and SENDER blank to use the account defaults (recommended)
AFRO_SMS_FROM=
AFRO_SMS_SENDER=
FIELD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
ENCRYPT_BACKFILL=false
